<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kondisi JalanKu</title>
    <style>
        /* Mengatur agar halaman memenuhi layar dan menghilangkan scrollbar bawaan */
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden; 
            background-color: #ffffff;
        }
        
        /* Mengatur iframe agar fullscreen dan responsif */
        #gas-iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
            display: block;
        }
    </style>
</head>
<body>

    <iframe id="gas-iframe" src="https://script.google.com/macros/s/AKfycbyZOn7YnOzYNceXRXwYMTR3cRG0CA5Hwalel43C07GkBuSB_8_PtcoJ4x6rCnIaQR7z5A/exec" allowfullscreen="true">
